root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

[*.{h,cpp}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,mdl}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
tab_width = 4
